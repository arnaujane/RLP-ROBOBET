flowchart LR
    subgraph U["Usuarios"]
        U1["Usuarios web"]
        U2["Espectadores Twitch"]
    end

    subgraph W["Frontend y Social"]
        WEB["Web propia (Node.js)\nUI de apuestas, estado, eventos sociales"]
        TWAPI["API de Twitch\nchat, eventos, autenticacion, integraciones"]
        TW["Canal Twitch\nstream en directo"]
    end

    subgraph C["Cloud / Backend"]
        API["Backend Node.js\nREST/WebSocket"]
        AUTH["Auth y sesiones"]
        BET["Motor de apuestas\nreglas, rondas, resolucion"]
        SOCIAL["Motor social\ncomandos, votos, efectos"]
        STATE["Estado en tiempo real\ntelemetria y eventos"]
        DB["Base de datos\nusuarios, apuestas, resultados, logs"]
        MEDIA["Servicio de media / ingesta\nrecibe video desde Raspberry"]
        SIGNAL["Canal de control\ncomandos hacia robot"]
    end

    subgraph R["Robot / Edge"]
        RPI["Raspberry Pi 4\norquestacion local"]
        CAMFPV["Camara FPV del robot"]
        CAMTOP["Camara cenital opcional\nvision global interna"]
        CTRL["Proceso de control\nmaze solver + FSM + navegacion"]
        VISION["Proceso de vision\ncaptura, compresion, envio cloud"]
        LOCAL["Bus local\nGPIO / I2C / CSI / sockets internos"]
        DRIVER["Controladora motores DRV8835"]
        SENS["Sensores IR QTR-8RC"]
        MOT["Motores DC + ruedas"]
        PWR["Bateria + cargador + convertidor DC"]
    end

    U1 -->|"usa la web"| WEB
    U2 -->|"ve el directo"| TW

    WEB -->|"HTTP / WebSocket"| API
    WEB <-->|"login, perfil, historial"| AUTH
    WEB <-->|"apuestas, cuotas, resultados"| BET
    WEB <-->|"ranking, eventos, social"| SOCIAL
    WEB <-->|"estado en vivo"| STATE

    API --> AUTH
    API --> BET
    API --> SOCIAL
    API --> STATE
    AUTH --> DB
    BET --> DB
    SOCIAL --> DB
    STATE --> DB

    WEB -->|"interacciones Twitch"| TWAPI
    TWAPI -->|"eventos de chat / canal"| SOCIAL
    MEDIA -->|"restream / publicacion"| TW

    CAMFPV -->|"video CSI"| RPI
    CAMTOP -->|"video auxiliar para IA/vision"| RPI
    RPI --> LOCAL
    LOCAL --> CTRL
    LOCAL --> VISION
    CTRL -->|"PWM / direccion"| DRIVER
    DRIVER --> MOT
    SENS -->|"lectura de linea / proximidad"| RPI
    PWR --> RPI
    PWR --> DRIVER

    CTRL -->|"telemetria, estado, posicion estimada"| STATE
    VISION -->|"stream de video uplink"| MEDIA
    API -->|"ordenes de partida, modo, efectos"| SIGNAL
    SIGNAL -->|"WebSocket / MQTT / HTTPS"| RPI
    SOCIAL -->|"eventos sociales que alteran la partida"| SIGNAL

    TW -->|"directo al publico"| U2

    classDef hw fill:#FFF3E0,stroke:#FB8C00,color:#222;
    classDef sw fill:#E3F2FD,stroke:#1E88E5,color:#222;
    classDef cloud fill:#E8F5E9,stroke:#43A047,color:#222;
    class DRIVER,SENS,MOT,PWR,CAMFPV,CAMTOP hw;
    class WEB,TWAPI,TW,API,AUTH,BET,SOCIAL,STATE,DB,MEDIA,SIGNAL,RPI,CTRL,VISION,LOCAL sw;
    class C,W,U cloud;
